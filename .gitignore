# 全部可由源视频重生成且属个人学习数据，不入库；脚本与 README 入库。
workspace/stt_cloud_batch/out/

# course_digest 工作区派生数据（2026-10-21 建）：
# _shots/ = 分诊时从用户视频抽出的拼图（画面内容本身，含个人信息）；
# course_manifest.json = 每支视频的时长/字幕/画面类型测量表（含真实文件名）。均不入库，脚本入库。
workspace/course_digest/_shots/
workspace/course_digest/course_manifest*.json
# out/ = 转录/结构化提取/帧/课稿，全部含用户课程原文或画面，可由源视频重生成，不入库。
workspace/course_digest/out/

# wechat_linux_audit/ = 微信 Linux 采集面审计（2026-09-30 起 ignore，经用户点单）：
# 仪器脚本与观测数据绑定本机（盘序列号 / MAC / cgroup / 登录态路径），属机器特定数据不入库；
# 结论与交接卡沉淀在项目记忆与 SKILL.md，不在仓库。
workspace/wechat_linux_audit/

# engineering_talk/ = 工程化分享讲稿工作区（2026-09-30 起 ignore，经用户点单）：
# 讲稿 md / PPTX / 生图素材 / node_modules 属展示产物，不入源码仓库。
workspace/engineering_talk/


# srum_attrib.py 的 SRUM 解析依赖（dissect.esedb，pip --target 装的目录）：
# 刻意不写进 pyproject（只有这一个偶发取证脚本用得到），也刻意不放在 temp/
# （temp 会被定期清理，脚本会"昨天能跑今天就崩"）。装在 tools/disk_io_audit/lib/
# 用法：uv run python tools/disk_io_audit/srum_attrib.py --db <SRUDB.dat> --lib tools/disk_io_audit/lib
tools/disk_io_audit/lib/

# chat_digest 一次性调试产物（2026-10-08 未提交文件审计新增）：
# temp/ 内含 message_5.db.pre_fastpath_test —— 3.5MB 微信消息库副本，真实群聊行级数据，
# 与已排除的 workspace/chat_digest/backup/ 和 digests/ 同隐私级别；另两个是一次性压测脚本。
# 先例见 workspace/video_digest/temp/ 同名规则。
workspace/chat_digest/temp/

# 带日期戳的备份 *.bak_YYYYMMDD（2026-10-08 新增）：
# 既有 *.bak 只匹配无后缀形式，.bak_20261005 这类漏网；备份含本机绝对路径
# （如 <data_drive>:/<apps_root>\VMware\vmrun.exe），与 *.bak 及
# workspace/bilibili_gacha/*.bak-* 同处理。误伤评估：已跟踪文件中无 .bak_/.bak- 结尾者。
*.bak_*

# 带序号后缀的备份 *.bak2 / *.bak3 / *.bak4（2026-10-19 新增）：
# 既有 *.bak 只匹配无后缀形式；jev_series 采集/补采脚本每次都留一份 .bakN 全量快照，
# 属同一批数据的历史副本，重跑采集脚本即可重建。误伤评估：已跟踪文件中无 .bakN 结尾者。
*.bak[0-9]

# tool_dojo 运行产物（2026-10-08 新增）：
# runs/ = 每轮体检的 dispatch 包与 traces（可能含 subagent 的真实工具调用记录），
# sandbox/ = local_reversible 档探针的落盘沙箱。两者都是可再生产物，不入库。
# state/inventory.json 是工具清单快照，属于有价值的历史基线，故意不排除。
workspace/tool_dojo/runs/
workspace/tool_dojo/sandbox/

